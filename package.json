{
  "name": "workplan",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "test": "vitest run",
    "test:e2e": "tsx tests/e2e/run.ts",
    "typecheck": "tsc --noEmit",
    "db:demo": "tsx --env-file-if-exists=.env scripts/demo-data.ts",
    "db:holidays": "tsx --env-file-if-exists=.env scripts/holidays.ts",
    "catalog:export": "tsx --env-file-if-exists=.env scripts/catalog-export.ts"
  },
  "dependencies": {
    "@fontsource/heebo": "^5.2.7",
    "@tanstack/react-query": "^5.90.2",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.544.0",
    "next": "^15.5.27",
    "nodemailer": "^10.1.0",
    "pg": "^8.16.3",
    "react": "~19.1.9",
    "react-dom": "~19.1.9",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/react": "~19.1",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.55.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
