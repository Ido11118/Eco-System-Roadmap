# העתק לקובץ .env ומלא ערכים אמיתיים. אין להכניס את .env לגיט.

# --- בסיס נתונים ---
DATABASE_URL=postgresql://workplan:CHANGE_ME@localhost:5432/workplan
# בשימוש ב-docker compose בלבד (סיסמת Postgres שהקונטיינר יוצר)
DB_PASSWORD=CHANGE_ME

# --- כתובת המערכת ---
# הכתובת הציבורית המלאה. משמשת לקישורי איפוס סיסמה, להגנת CSRF ולקביעת עוגיות Secure (כש-https)
APP_URL=https://workplan.your-org.example

# --- Super User (נוצר באתחול הראשון בלבד; סיסמה באורך 8 תווים לפחות) ---
SUPERUSER_EMAIL=admin@your-org.example
SUPERUSER_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SUPERUSER_NAME=מנהל המערכת

# --- מאחורי Reverse Proxy (nginx וכו') ---
# true = הגבלת ניסיונות ההתחברות לפי כתובת הלקוח מ-X-Forwarded-For
TRUST_PROXY=false
# לכפות עוגיות Secure ללא תלות ב-APP_URL (true/false). ריק = לפי APP_URL
COOKIE_SECURE=

# --- התראות במייל למנהל המערכת (הרשמה חדשה, בקשת הרשאות, פנייה לאיפוס סיסמה) ---
# Resend (resend.com, חינם עד 3,000 מיילים בחודש) — עובד ב-Railway בכל תוכנית (שליחה ב-HTTPS; SMTP חסום ב-Hobby).
# בלי דומיין מאומת, Resend שולח רק לכתובת שאיתה נפתח החשבון — לכן פותחים אותו עם המייל של מנהל המערכת.
RESEND_API_KEY=
# כתובת השולח (רק עם דומיין מאומת ב-Resend). ריק = onboarding@resend.dev
MAIL_FROM=
# לאן לשלוח את ההתראות. ריק = כתובת מנהל המערכת (SUPERUSER)
ADMIN_NOTIFY_EMAIL=

# --- דוא"ל דרך SMTP (אופציונלי, לשרתים שמאפשרים SMTP). בלי SMTP: המנהל מפיק קישורי איפוס ממסך ניהול המשתמשים ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# לכתוב קישורי איפוס ללוג בייצור (לא מומלץ)
LOG_RESET_LINKS=false

# --- התחברות עם Google (לא חובה; בלי שני הערכים הראשונים הכפתור לא מוצג) ---
# יוצרים ב-Google Cloud Console (מדריך: docs/SETUP-GOOGLE-AND-AI.md).
# כתובת החזרה שמגדירים שם: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# הגבלה לדומיין ארגוני של Google Workspace (למשל your-org.com; כמה דומיינים — מופרדים בפסיק). ריק = כל חשבון Google
# (משתמש חדש תמיד ממתין לאישור מנהל המערכת)
GOOGLE_ALLOWED_DOMAINS=
